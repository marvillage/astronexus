# NASA APIs (APOD, NeoWs) — get a free key at https://api.nasa.gov
# Falls back to DEMO_KEY (heavily rate-limited) if unset.
NASA_API_KEY=DEMO_KEY

# Optional: N2YO key for satellite pass predictions (https://www.n2yo.com/api/)
# Without it, the Satellite tracker shows live ISS position only.
N2YO_API_KEY=
